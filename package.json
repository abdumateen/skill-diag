{
  "name": "skill-diag",
  "version": "0.1.0",
  "description": "Capability surface observability for agent skills: will a skill load, will it fire, can the router still find it at scale",
  "type": "module",
  "license": "MIT",
  "bin": {
    "skill-diag": "dist/cli.js"
  },
  "files": [
    "dist",
    "contracts",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.17.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
