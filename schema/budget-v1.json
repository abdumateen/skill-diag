{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skill-diag.dev/schema/budget-v1.json",
  "title": "skill-diag report (lint / budget --json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tool", "host", "contextWindow", "generatedAt", "summary", "coverage", "budget", "findings"],
  "properties": {
    "version": { "type": "string" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "host": { "type": "string" },
    "contextWindow": { "type": "number", "minimum": 1 },
    "generatedAt": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "commands", "errors", "warnings", "runtimeFindings", "exitCode"],
      "properties": {
        "skills": { "type": "integer", "minimum": 0 },
        "commands": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "runtimeFindings": { "type": "integer", "minimum": 0 },
        "exitCode": { "enum": [0, 1, 2] }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userSkills", "pluginSkills"],
      "properties": {
        "userSkills": { "type": "integer", "minimum": 0 },
        "pluginSkills": { "type": "integer", "minimum": 0 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limitChars",
        "limitSource",
        "exact",
        "limitVerified",
        "limitNote",
        "rawChars",
        "effectiveChars",
        "percentUsed",
        "perEntryCapChars",
        "commandCount",
        "overhead"
      ],
      "properties": {
        "limitChars": { "type": "number", "minimum": 0 },
        "limitSource": { "type": "string" },
        "exact": { "type": "boolean" },
        "limitVerified": { "type": "boolean" },
        "limitNote": { "type": "string" },
        "rawChars": { "type": "number", "minimum": 0 },
        "effectiveChars": { "type": "number", "minimum": 0 },
        "percentUsed": { "type": "number" },
        "perEntryCapChars": { "type": "number", "minimum": 0 },
        "commandCount": { "type": "integer", "minimum": 0 },
        "overhead": {
          "type": "object",
          "additionalProperties": false,
          "required": ["charsPerEntry", "calibrated", "note"],
          "properties": {
            "charsPerEntry": { "type": "number" },
            "calibrated": { "type": "boolean" },
            "note": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "tier", "severity", "skill", "source", "path", "message"],
        "properties": {
          "checkId": { "type": "string" },
          "tier": { "enum": [1, 2] },
          "severity": { "enum": ["error", "warning", "info"] },
          "skill": { "type": "string" },
          "source": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 },
          "message": { "type": "string" },
          "fix": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "confidence"],
            "properties": {
              "kind": { "type": "string" },
              "field": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "confidence": { "enum": ["certain", "likely", "heuristic", "diagnostic"] }
            }
          }
        }
      }
    }
  }
}
