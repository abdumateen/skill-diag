{
  "host": "claude-code",
  "versionRange": ">=2.0.70",
  "skillRoots": ["~/.claude/skills", ".claude/skills"],
  "commandRoots": [".claude/commands", "~/.claude/commands"],
  "severity": {
    "description-capped": "error"
  },
  "frontmatter": {
    "required": [],
    "recommended": ["description"],
    "namePattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "nameMaxLength": 64,
    "nameMustMatchDirectory": true,
    "descriptionMaxLength": 1024,
    "allowedFields": [
      "name",
      "description",
      "when_to_use",
      "argument-hint",
      "arguments",
      "disable-model-invocation",
      "user-invocable",
      "allowed-tools",
      "disallowed-tools",
      "model",
      "effort",
      "context",
      "agent",
      "background",
      "hooks",
      "paths",
      "shell",
      "license",
      "compatibility",
      "metadata",
      "version"
    ],
    "openStandardFields": [
      "name",
      "description",
      "license",
      "compatibility",
      "metadata",
      "allowed-tools"
    ],
    "rejectedOnUploadPath": ["argument-hint"]
  },
  "listingBudget": {
    "mode": "absolute_with_context_override",
    "fraction": 0.01,
    "absoluteDefaultChars": 15000,
    "envOverride": "SLASH_COMMAND_TOOL_CHAR_BUDGET",
    "perEntryCapChars": 1536,
    "defaultContextWindow": 200000,
    "charsPerToken": 4,
    "overheadCharsPerEntry": 0,
    "overheadCalibrated": false,
    "overheadNote": "UNcalibrated placeholder. Effective chars therefore equal raw chars until the §11.2 harness produces a measurement.",
    "calibrationUnavailableReason": "claude-skills-doctor: host unusable for calibration — claude -p exits 1 with [claude-code:unrecognized_model] (model: anthropic/custom-.../deepseek-v4.1-flash:free), duration_api_ms: 0, 0 tokens. Host version 2.1.251 is also signed out (~/.claude.json has no oauthAccount). Overhead constant and budget limit remain unmeasured until the host is both signed in and pointed at a working model.",
    "limitVerification": {
      "measured": false,
      "competingValue": 8000,
      "competingSource": "claude-skills-doctor 0.7.0: 1% of a 200,000-token window at 4 chars/token"
    }
  },
  "dropBehavior": {
    "namesAlwaysListed": true,
    "dropTarget": "descriptions",
    "dropOrder": "unknown",
    "confidence": "none",
    "calibrationMethod": "unverified",
    "evidence": "calibration/drop-order-result.json",
    "reason": "host unusable — see calibrationUnavailableReason"
  },
  "priorityOrder": ["enterprise", "personal", "project", "plugin"]
}
